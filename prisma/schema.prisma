generator client {
  provider = "prisma-client-js"
}

// SQLite للتطوير المحلي. عند النشر نغيّرها لـ postgresql (سطر واحد).
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Branch {
  id         Int      @id @default(autoincrement())
  name       String
  address    String?
  supervisor String?
  phone      String?
  notes      String?
  workers    Worker[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Housing {
  id        Int      @id @default(autoincrement())
  name      String
  address   String?
  notes     String?
  workers   Worker[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Worker {
  id         Int      @id @default(autoincrement())
  name       String
  code       String?  // الرقم الوظيفي
  phone      String?
  jobTitle   String?
  shiftStart String   // "08:00"
  shiftEnd   String   // "16:00"
  daysOff    String   @default("") // أرقام الأيام مفصولة بفاصلة: 0=الأحد ... 6=السبت
  notes      String?
  branchId   Int
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  housingId  Int?
  housing    Housing? @relation(fields: [housingId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([branchId])
  @@index([housingId])
}
